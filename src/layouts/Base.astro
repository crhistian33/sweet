---
import "../styles/global.css";
import {
  marca,
  estiloVars,
  urlFuentes,
  url,
  rutas,
  configTienda,
  enlaceWhatsApp,
} from "../lib/datos";

const { titulo, descripcion, pagina = "inicio" } = Astro.props;
const configJson = JSON.stringify(configTienda).replace(/</g, "\\u003c");
const consulta = enlaceWhatsApp(
  marca.contacto.whatsapp,
  marca.contacto.mensaje,
);
---

<!doctype html>
<html lang="es" style={estiloVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content={marca.colores.principal} />
    <link rel="icon" href={url(marca.logo)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={urlFuentes} />
  </head>
  <body data-pagina={pagina}>
    <a class="salto" href="#contenido">
      Saltar al contenido
    </a>

    <header class="encabezado">
      <div class="contenedor">
        <a class="marca" href={rutas.inicio}>
          <img
            src={url(marca.logo)}
            alt=""
            width="120"
            loading="eager"
          />
          { marca.nombre && (
            <span>{marca.nombre}</span>
          )}
        </a>
        <div class="encabezado-derecha">
          <nav class="menu" id="menu-principal" aria-label="Principal">
            <a href={rutas.inicio}>Inicio</a>
            <a href={`${rutas.inicio}#productos`}>Productos</a>
            <a href={`${rutas.inicio}#nosotros`}>Nosotros</a>
          </nav>

          <div class="encabezado-acciones">
            <a class="carrito-enlace" href={rutas.carrito}>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                <line x1="3" y1="6" x2="21" y2="6" />
                <path d="M16 10a4 4 0 0 1-8 0" />
              </svg>
              <span class="carrito-texto">Carrito</span>
              <span class="contador" data-contador hidden>
                0
              </span>
            </a>

            <button
              type="button"
              class="menu-toggle"
              id="menu-toggle"
              aria-label="Abrir menú"
              aria-expanded="false"
              aria-controls="menu-principal"
            >
              <span class="icono-burger" aria-hidden="true">
                <span class="linea"></span>
                <span class="linea"></span>
                <span class="linea"></span>
              </span>
            </button>
          </div>
        </div>
      </div>
      <!-- Fondo traslúcido para cerrar menú al pulsar afuera en móviles -->
      <div class="menu-fondo" id="menu-fondo" aria-hidden="true"></div>
    </header>

    <div id="contenido" tabindex="-1">
      <slot />
    </div>

    <footer class="pie">
      <div class="contenedor">
        <div class="pie-marca">
          <img
            src={url(marca.logo)}
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
          <span>
            © {new Date().getFullYear()} {marca.nombre}. Proyecto escolar de
            Educación para el Trabajo.
          </span>
        </div>
        <p>
          <a href={consulta} target="_blank" rel="noopener">
            ¿Dudas? Escríbenos por WhatsApp
          </a>
        </p>
      </div>
    </footer>

    <p id="anuncios" class="solo-lectores" aria-live="polite"></p>
    <script id="config-tienda" type="application/json" set:html={configJson} />
    <script>
      import "../scripts/tienda";
    </script>

    <!-- Script inline: scroll-aware header y menú responsive -->
    <script is:inline>
      (function () {
        // Sticky header
        var header = document.querySelector(".encabezado");
        if (header) {
          var ultimo = 0;
          function onScroll() {
            var y = window.scrollY;
            if (y > 10 && ultimo <= 10) header.classList.add("pegado");
            else if (y <= 10 && ultimo > 10) header.classList.remove("pegado");
            ultimo = y;
          }
          window.addEventListener("scroll", onScroll, { passive: true });
          onScroll();
        }

        // Menú hamburguesa móvil
        var toggle = document.getElementById("menu-toggle");
        var menu = document.getElementById("menu-principal");
        var fondo = document.getElementById("menu-fondo");

        if (!toggle || !menu) return;

        function abrirMenu() {
          toggle.setAttribute("aria-expanded", "true");
          toggle.setAttribute("aria-label", "Cerrar menú");
          menu.classList.add("abierto");
          if (fondo) fondo.classList.add("abierto");
        }

        function cerrarMenu() {
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Abrir menú");
          menu.classList.remove("abierto");
          if (fondo) fondo.classList.remove("abierto");
        }

        toggle.addEventListener("click", function () {
          var abierto = toggle.getAttribute("aria-expanded") === "true";
          if (abierto) {
            cerrarMenu();
          } else {
            abrirMenu();
          }
        });

        if (fondo) {
          fondo.addEventListener("click", cerrarMenu);
        }

        // Cerrar al pulsar Escape
        window.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            cerrarMenu();
            toggle.focus();
          }
        });

        // Cerrar al hacer clic en cualquier enlace del menú móvil
        menu.querySelectorAll("a").forEach(function (enlace) {
          enlace.addEventListener("click", function () {
            cerrarMenu();
          });
        });

        // Cerrar automáticamente si se pasa a vista de escritorio
        window.addEventListener("resize", function () {
          if (window.innerWidth > 768 && toggle.getAttribute("aria-expanded") === "true") {
            cerrarMenu();
          }
        }, { passive: true });
      })();
    </script>
  </body>
</html>
